# Contact form delivery (set these in Vercel → Project → Settings → Environment Variables).
# The destination address lives only here, never in the page source.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Farooq Shabbir · Website <inquiries@mail.farooqshabbir.online>"
CONTACT_FROM_EMAIL=
